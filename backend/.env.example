# Энэ файлыг .env нэрээр хуулаад өөрийн орчны утгуудаар бөглөнө үү.
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres ашиглах бол (infra/docker-compose.yml-тэй тааруулна):
DATABASE_URL=postgres://ticket_user:ticket_pass@localhost:5432/ticket_db

# Заагаагүй тохиолдолд sqlite ашиглаж локал дээр шууд ажиллана.
# DATABASE_URL=sqlite:///db.sqlite3

DEFAULT_FROM_EMAIL=noreply@ticket-system.local

# --- Email (SMTP) ---
# EMAIL_HOST заавал бол мэйл жинхэнэ шуудангаар явна; заагаагүй бол зөвхөн лог руу хэвлэнэ.
# Gmail жишээ: Google Account → Security → 2-Step Verification → App passwords-оос 16 оронтой нууц үг авна.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your.address@gmail.com
# EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx
# DEFAULT_FROM_EMAIL=TMS Foxt <your.address@gmail.com>
