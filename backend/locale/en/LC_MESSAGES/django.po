msgstr "Only a superuser can delete a superuser."

#: apps/accounts/views.py:91
#, python-format
msgid "'%(name)s' хэрэглэгч устгагдлаа."
msgstr "User '%(name)s' was deleted."

#: apps/accounts/views.py:100
#, python-format
msgid ""
"'%(name)s' ticket-ийн түүхтэй тул устгах боломжгүй — оронд нь идэвхгүй "
"болгож, нэвтрэх эрхийг хаалаа."
msgstr ""
"'%(name)s' has ticket history and cannot be deleted — the account was "
"deactivated instead and can no longer sign in."

#: apps/accounts/views.py:111
msgid "Өөрийгөө идэвхгүй болгох боломжгүй."
msgstr "You cannot deactivate yourself."

#: apps/accounts/views.py:113
msgid "Superuser-ийг зөвхөн superuser идэвхгүй болгоно."
msgstr "Only a superuser can deactivate a superuser."

#: apps/accounts/views.py:117
#, python-format
msgid "'%(name)s' идэвхгүй боллоо — нэвтрэх эрх хаагдлаа."
msgstr "'%(name)s' was deactivated — sign-in is disabled."

#: apps/accounts/views.py:129
#, python-format
msgid ""
"'%(name)s'-д %(n)s нээлттэй ticket оноогдсон байна — ticket бүрийн "
"\"Хариуцагч солих\" хэсгээс өөр хүнд шилжүүлнэ үү."
msgstr ""
"'%(name)s' still has %(n)s open ticket(s) — reassign them via \"Change "
"assignee\" on each ticket."

#: apps/accounts/views.py:139
msgid "Superuser-ийг зөвхөн superuser идэвхжүүлнэ."
msgstr "Only a superuser can reactivate a superuser."

#: apps/accounts/views.py:143
#, python-format
msgid "'%(name)s' дахин идэвхжлээ."
msgstr "'%(name)s' was reactivated."

