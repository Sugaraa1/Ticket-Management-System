#, python-format
msgid "Холбогдож чадсангүй: %(err)s"
msgstr "Could not connect: %(err)s"

#: apps/autotest/api.py:194
#, python-format
msgid "Хүсэлт илгээж чадсангүй: %(err)s"
msgstr "Could not send the request: %(err)s"

#: apps/autotest/api.py:202
msgid "Хэт олон redirect."
msgstr "Too many redirects."

#: apps/autotest/api.py:236
#, python-format
