#: apps/tickets/models.py:92
msgid ""
"Priority-с хамаарсан хариу үйлдэл хийх дээд хугацаа (settings."
"SLA_HOURS_BY_PRIORITY-ээс ticket үүсэх мөчид автоматаар тооцоологдоно)."
msgstr ""
"Maximum response time based on priority (calculated automatically from "
"settings.SLA_HOURS_BY_PRIORITY when the ticket is created)."

#: apps/tickets/models.py:100
msgid ""
"SLA хугацаа дуусахад ойртсон тухай анхааруулга илгээсэн огноо "
"(check_sla_deadlines командаар бичигдэнэ, давхар мэдэгдэл илгээхээс "
"сэргийлнэ)."
msgstr ""
"Date the SLA-approaching warning was sent (written by the "
"check_sla_deadlines command; prevents duplicate notifications)."

#: apps/tickets/models.py:108
msgid ""
"SLA хугацаа хэтэрсэн тухай escalation мэдэгдэл илгээсэн огноо "
"(check_sla_deadlines командаар бичигдэнэ, давхар мэдэгдэл илгээхээс "
"сэргийлнэ)."
msgstr ""
"Date the SLA breach escalation was sent (written by the check_sla_deadlines "
"command; prevents duplicate notifications)."

#: apps/tickets/models.py:116
msgid ""
"'Time to First Response' SLA — эхний хариу өгөх дээд хугацаа (settings."
"SLA_FIRST_RESPONSE_HOURS_BY_PRIORITY-ээс автоматаар тооцоологдоно)."
msgstr ""
"'Time to First Response' SLA — maximum time to send a first reply "
"(calculated automatically from settings."
"SLA_FIRST_RESPONSE_HOURS_BY_PRIORITY)."

#: apps/tickets/models.py:124
msgid ""
"Ticket-д анх удаа хариу өгсөн (NEW-аас шилжсэн эсвэл мэдээлэгчээс бусад хүн "
"comment бичсэн) огноо."
msgstr ""
"Date the ticket first received a response (transitioned away from NEW, or "
"someone other than the reporter added a comment)."

#: apps/tickets/models.py:134
msgid ""
"Ticket дээр сүүлд ямар нэгэн идэвх (status шилжилт, comment, attachment) "
"гарсан огноо — 'идэвхгүй ticket' automation-д ашиглагдана."
msgstr ""
"Date of the ticket's most recent activity (status transition, comment, "
"attachment) — used by the 'stale ticket' automation."

#: apps/tickets/models.py:142
msgid ""
"Идэвхгүй байдлын тухай сүүлд сануулга илгээсэн огноо (check_stale_tickets "
"командаар бичигдэнэ). Шинэ идэвх гарахад цэвэрлэгдэж, дараагийн удаа дахин "
"сануулах боломжтой болно."
msgstr ""
"Date the last stale-ticket reminder was sent (written by the "
"check_stale_tickets command). Cleared when new activity occurs, allowing "
"another reminder next time."

#: apps/tickets/models.py:256
#, python-format
msgid ""
"'%(from_status)s' -> '%(to_status)s' төлөв шилжилт зөвшөөрөгдөөгүй байна "
"(docs/workflow.md-г үзнэ үү)."
msgstr ""
"Transition '%(from_status)s' -> '%(to_status)s' is not allowed (see docs/"
"workflow.md)."

#: apps/tickets/models.py:299
#, python-format
