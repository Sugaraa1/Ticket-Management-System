msgstr "Could not log in to the API: %(err)s"

#: apps/autotest/api.py:240
#, python-format
msgid ""
"'%(user)s' хэрэглэгчээр API-д нэвтэрч чадсангүй: HTTP %(status)s %(body)s"
msgstr "Could not log in to the API as '%(user)s': HTTP %(status)s %(body)s"

#: apps/autotest/api.py:250
#, python-format
msgid "API нэвтрэх хариунд token ч, cookie ч ирсэнгүй (HTTP %(status)s)."
msgstr ""
"The API login response had neither a token nor a cookie (HTTP %(status)s)."

