# Энэ файлыг .env нэрээр infra/ дотор хуулаад ашиглана.
# backend/.env-тэй ЯГ ТААРАХ ёстой утгууд (Postgres холболт).

POSTGRES_DB=ticket_db
POSTGRES_USER=ticket_user
POSTGRES_PASSWORD=ticket_pass

# Host компьютер дээр Postgres 5432 дээр аль хэдийн ажиллаж байгаа тул
# docker-ийн db service-ийг 5433 порт руу гаргасан (container дотоод холболт
# өөрчлөгдөхгүй, зөвхөн host дээрх portыг зөрчилдөхөөс сэргийлнэ).
POSTGRES_HOST_PORT=5433

SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DEFAULT_FROM_EMAIL=noreply@ticket-system.local

# Автомат тест: localhost / Docker-ийн дотоод хаяг (http://web:8000) руу хандахыг зөвшөөрнө.
AUTOTEST_ALLOW_PRIVATE_HOSTS=True
# Нэвтрэх буруу оролдлогын хязгаар (default 5 → 15 минут түгжинэ). Local-д login-ийг автомат
# тестээр олон буруу нууц үгээр шалгахад өсгөнө. Production-д бүү өөрчил.
# LOGIN_FAILURE_LIMIT=1000
